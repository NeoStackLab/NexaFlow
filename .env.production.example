# Every image must be immutable (prefer an @sha256 digest).
POSTGRES_IMAGE=pgvector/pgvector@sha256:replace-with-reviewed-digest
REDIS_IMAGE=redis@sha256:replace-with-reviewed-digest
BACKEND_IMAGE=ghcr.io/neostacklab/nexaflow-backend@sha256:replace-with-release-digest
FRONTEND_IMAGE=ghcr.io/neostacklab/nexaflow-frontend@sha256:replace-with-release-digest
BACKUP_IMAGE=ghcr.io/neostacklab/nexaflow-backup@sha256:replace-with-release-digest
NGINX_IMAGE=nginxinc/nginx-unprivileged@sha256:replace-with-reviewed-digest

PUBLIC_ORIGIN=https://nexaflow.example.com
BILLING_SUCCESS_URL=https://nexaflow.example.com/admin/billing?checkout=success
BILLING_CANCEL_URL=https://nexaflow.example.com/admin/billing?checkout=cancel
POSTGRES_USER=nexaflow_admin
POSTGRES_DB=nexaflow
DATABASE_USER=nexaflow_app
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=nexaflow-production
OTEL_EXPORTER_ENDPOINT=otel-collector.monitoring.svc:4318
BACKUP_S3_URI=s3://nexaflow-backups/database
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=us-east-1
BACKUP_RETENTION_DAYS=35
BACKUP_EVIDENCE_S3_URI=s3://nexaflow-backups/restore-evidence

# Copy secrets/README.md.example to a private directory named secrets/ and
# replace every placeholder. Never commit that directory.
